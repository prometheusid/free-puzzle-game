<Window x:Class="SusunGambar.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gambar utuh"
        Width="640"
        Height="700"
        MinWidth="320"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PreviewBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#F4F5FA" />
        <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="PreviewMutedBrush" Color="#777D91" />
        <SolidColorBrush x:Key="PreviewBorderBrush" Color="#E2E4ED" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PreviewTitle" Text="GAMBAR UTUH" Foreground="#5B67F1" FontSize="11"
                       FontWeight="Bold" />
            <TextBlock x:Name="PreviewDescription" Text="Gunakan gambar ini sebagai petunjuk."
                       Foreground="{DynamicResource PreviewMutedBrush}"
                       FontSize="13" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PreviewSurfaceBrush}"
                BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="12">
            <Image x:Name="FullImage" Stretch="Uniform" />
        </Border>
        <Button x:Name="CloseButton" Grid.Row="2" Content="Tutup" IsDefault="True" Click="Close_Click"
                Height="42" Width="110" HorizontalAlignment="Right" Margin="0,18,0,0"
                Background="#5B67F1" Foreground="White" BorderThickness="0"
                FontWeight="SemiBold" Cursor="Hand" />
    </Grid>
</Window>
