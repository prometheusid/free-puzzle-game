<Window x:Class="SusunGambar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susun Gambar"
        Width="1120"
        Height="790"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#EEF0F8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#20243A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#777D91" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#777D91" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#555B70" />
        <SolidColorBrush x:Key="FooterTextBrush" Color="#969BAD" />
        <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F6F7FB" />
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#EEF0FF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#4D58D8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B67F1" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E2E4ED" />
        <SolidColorBrush x:Key="TileBorderBrush" Color="White" />
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SoftAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />
                            <ContentPresenter x:Name="SelectionPresenter"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Grid.Column="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionPresenter"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadableButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter x:Name="ButtonContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground"
                                        Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderEyebrow" Text="PUZZLE GAMBAR" Foreground="#5B67F1" FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="HeaderTitle" Text="Susun potongannya." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30"
                           FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock x:Name="HeaderSubtitle" Text="Pilih gambar favoritmu, lalu susun kembali sampai utuh."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="LanguageBox" Width="150" Height="40" FontSize="13"
                          SelectionChanged="LanguageBox_SelectionChanged"
                          ToolTip="Pilih bahasa">
                    <ComboBoxItem Content="Bahasa Indonesia" Tag="id" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
                <Button x:Name="ThemeButton" Content="🌙  Mode gelap"
                        Click="ThemeButton_Click" Height="40" Padding="16,0" Margin="10,0,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" Cursor="Hand" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="18"
                    Padding="16" Margin="0,0,20,0">
                <Grid x:Name="BoardHost" Background="{DynamicResource BoardBackgroundBrush}" ClipToBounds="True">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Width="310">
                        <TextBlock Text="🧩" FontSize="58" HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <TextBlock x:Name="EmptyTitle" Text="Siap bermain?" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyDescription" Text="Mulai dengan gambar contoh, atau pilih fotomu sendiri."
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,8,0,20" />
                        <Button x:Name="StartSampleButton" Content="Mulai dengan gambar contoh" Click="StartSample_Click"
                                Height="44" Background="#5B67F1" Foreground="White"
                                FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="SettingsTitle" Text="PENGATURAN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               FontWeight="Bold" />
                    <Button x:Name="ChooseImageButton" Content="Pilih Gambar" Click="ChooseImage_Click" Height="44"
                            Margin="0,14,0,0" Background="#5B67F1" Foreground="White"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" />

                    <TextBlock x:Name="DifficultyLabel" Text="Tingkat kesulitan" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                               FontWeight="SemiBold" Margin="0,22,0,8" />
                    <ComboBox x:Name="DifficultyBox" SelectedIndex="0"
                              SelectionChanged="DifficultyBox_SelectionChanged"
                              Height="40" FontSize="14">
                        <ComboBoxItem Content="Mudah — 3 × 3" Tag="3" />
                        <ComboBoxItem Content="Sedang — 4 × 4" Tag="4" />
                        <ComboBoxItem Content="Sulit — 5 × 5" Tag="5" />
                    </ComboBox>

                    <Button x:Name="ShuffleButton" Style="{StaticResource ReadableButtonStyle}"
                            Content="Acak potongan" Click="Shuffle_Click"
                            Height="44" Margin="0,12,0,0" Background="{DynamicResource SoftAccentBrush}"
                            Foreground="{DynamicResource AccentTextBrush}" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" IsEnabled="False" />

                    <Border Background="{DynamicResource SoftSurfaceBrush}" CornerRadius="12" Padding="14"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MovesLabel" Text="LANGKAH" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="MovesText" Text="0" FontSize="24"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TimeLabel" Text="WAKTU" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TimeText" Text="00:00" FontSize="24"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="HowToTitle" Text="CARA BERMAIN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               FontWeight="Bold" Margin="0,22,0,9" />
                    <TextBlock x:Name="HowToText" Text="Klik dua potongan untuk menukar posisinya. Kamu juga bisa menarik satu potongan ke potongan lain."
                               Foreground="{DynamicResource TextBodyBrush}" FontSize="13" TextWrapping="Wrap"
                               LineHeight="20" />

                    <Button x:Name="PreviewButton" Style="{StaticResource ReadableButtonStyle}"
                            Content="Lihat gambar utuh"
                            Click="Preview_Click" Height="40" Margin="0,16,0,0"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"
                            FontWeight="SemiBold" BorderBrush="{DynamicResource SubtleBorderBrush}"
                            Cursor="Hand" IsEnabled="False" />
                    <TextBlock x:Name="StatusText" Text="Pilih gambar untuk memulai."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="2" Text="Susun Gambar  •  Mainkan dengan gambar favoritmu"
                   Foreground="{DynamicResource FooterTextBrush}" FontSize="11" HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
    </Grid>
</Window>
